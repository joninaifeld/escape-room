@{
    ViewData["Title"] = "Térmica";
}

<img src= "/images/termica.png">
<section class="termica">
    <h1>@ViewBag.titulo</h1>
    <p>@ViewBag.descripcion</p>

    <div>
        <form method="post" Action='@Url.Action("RevisarLetras", "Home")'>
            <button name="letra" value="a"></button>
            <button name="letra" value="v"></button>
            <button name="letra" value="c"></button>
            <button name="letra" value="s"></button>
            <button name="letra" value="l"></button>
            <button name="letra" value="e"></button>
        </form>
    </div>
    <ul>
        <li>1 = a</li>
        <li>2 = v</li>
        <li>3 = c</li>
        <li>4 = s</li>
        <li>5 = l</li>
        <li>6 = e</li>
        <li>No repitas!</li>
    </ul>
    @if(ViewBag.cantBotonesTocados > 0)
    {
        <h5>@ViewBag.cantBotonesTocados / 6</h5>
    }
    else
    {
        <h5>0 / 6</h5>
    }
    <h4>@ViewBag.mensaje</h4>
</section>