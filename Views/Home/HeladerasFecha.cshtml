@{
    ViewData["Title"] = "Heladeras";
}

<img src= "/images/heladeras-fechas.png">
<section class="heladeras-fechas">
    <h1>@ViewBag.titulo</h1>
    <p>@ViewBag.descripcion</p>

    <form method="post" Action='@Url.Action("IrASala", "Home")'>
        <input autocomplete="off" autofocus type="text" placeholder="Ingresá la respuesta" required name="ans">
        <button type="submit">Enviar</button>
    </form>

    <h4>@ViewBag.mensaje</h4>
</section>